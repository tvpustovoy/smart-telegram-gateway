{
  "name": "smart-telegram-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Reliable gateway between Telegram and an AI agent",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/core",
    "packages/gateway",
    "packages/channel",
    "packages/cli",
    "test/fake-telegram",
    "test/fake-channel",
    "test/fake-elevenlabs",
    "test/e2e"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "npm run build && npm run test:only",
    "test:only": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec --test-timeout=120000 \"packages/*/dist/**/*.test.js\" \"test/*/dist/**/*.test.js\"",
    "doctor": "node --disable-warning=ExperimentalWarning packages/cli/dist/index.js doctor",
    "release-check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
